# =============================================================
# Mastodon .env.production
# Fill in all REPLACE_ME values before running deploy script
# This file lives on the EC2 server at /opt/mastodon/.env.production
# NEVER commit this file to GitHub
# =============================================================

# ── Core ──────────────────────────────────────────────────────
LOCAL_DOMAIN=mastodon.dpdns.org
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=false

# ── Secrets (generated by 02-deploy-mastodon.sh) ─────────────
SECRET_KEY_BASE=REPLACE_ME
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=REPLACE_ME
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=REPLACE_ME
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=REPLACE_ME

# ── Database ──────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=REPLACE_ME

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Media Storage (AWS S3) ────────────────────────────────────
S3_ENABLED=true
S3_BUCKET=REPLACE_ME
S3_REGION=us-east-1
S3_PROTOCOL=https
S3_ALIAS_HOST=REPLACE_ME
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ── Email (Amazon SES) ────────────────────────────────────────
SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_LOGIN=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM_ADDRESS=notifications@mastodon.dpdns.org
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=none
SMTP_ENABLE_STARTTLS=auto

# ── Web Push (VAPID) — generated by deploy script ─────────────
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_PUBLIC_KEY=REPLACE_ME

# ── Search (disabled — no OpenSearch on free tier) ────────────
ES_ENABLED=false

# ── Tor federation ────────────────────────────────────────────
http_hidden_proxy=http://privoxy:8118
ALLOW_ACCESS_TO_HIDDEN_SERVICE=true

# ── Performance (tuned for t3.small 2 GB RAM) ─────────────────
WEB_CONCURRENCY=1
MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
PREPARED_STATEMENTS=false

# ── Privacy ───────────────────────────────────────────────────
IP_RETENTION_PERIOD=31556952
SESSION_RETENTION_PERIOD=31556952
